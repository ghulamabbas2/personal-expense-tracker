# Dependencies — reinstalled inside the image
node_modules

# Next.js build output — rebuilt inside the image
.next
out

# Environment files — secrets must NEVER be baked into the image
.env
.env.local
.env.development
.env.production
.env.staging
.env.*.local

# Git history — not needed at runtime
.git
.gitignore
.gitattributes

# CI / tooling — not needed at runtime
.github
.claude

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS artefacts
.DS_Store
Thumbs.db

# Editor config
.vscode
.idea
*.swp
*.swo

# Test coverage
coverage

# Documentation
docs
README.md

# TypeScript build cache — rebuilt inside the image
*.tsbuildinfo
